{
  "rules": [
    {
      "pattern": "node_modules/**",
      "allowEdits": false
    },
    {
      "pattern": ".expo/**",
      "allowEdits": false
    },
    {
      "pattern": ".expo-shared/**",
      "allowEdits": false
    },
    {
      "pattern": "dist/**",
      "allowEdits": false
    },
    {
      "pattern": "web-build/**",
      "allowEdits": false
    },
    {
      "pattern": "*.pem",
      "allowEdits": false
    },
    {
      "pattern": ".env*",
      "allowEdits": false
    },
    {
      "pattern": "*.tsbuildinfo",
      "allowEdits": false
    },
    {
      "pattern": ".vscode/**",
      "allowEdits": false
    },
    {
      "pattern": ".cursor/**",
      "allowEdits": false
    },
    {
      "pattern": ".continue/**",
      "allowEdits": false
    },
    {
      "pattern": ".history/**",
      "allowEdits": false
    },
    {
      "pattern": ".idea/**",
      "allowEdits": false
    },
    {
      "pattern": "**/*.jks",
      "allowEdits": false
    },
    {
      "pattern": "**/*.p8",
      "allowEdits": false
    },
    {
      "pattern": "**/*.p12",
      "allowEdits": false
    },
    {
      "pattern": "**/*.key",
      "allowEdits": false
    },
    {
      "pattern": "**/*.mobileprovision",
      "allowEdits": false
    },
    {
      "pattern": "output/**",
      "allowEdits": false
    },
    {
      "pattern": "logs/**",
      "allowEdits": false
    },
    {
      "pattern": "coverage/**",
      "allowEdits": false
    },
    {
      "pattern": "tmp/**",
      "allowEdits": false
    },
    {
      "pattern": "temp/**",
      "allowEdits": false
    },
    {
      "pattern": ".cache/**",
      "allowEdits": false
    },
    {
      "pattern": ".DS_Store",
      "allowEdits": false
    },
    {
      "pattern": "**/*.orig.*",
      "allowEdits": false
    },
    {
      "pattern": "**/*.log",
      "allowEdits": false
    },
    {
      "pattern": "**/metro-health-check*",
      "allowEdits": false
    },
    {
      "pattern": "**/npm-debug.*",
      "allowEdits": false
    },
    {
      "pattern": "**/yarn-debug.*",
      "allowEdits": false
    },
    {
      "pattern": "**/yarn-error.*",
      "allowEdits": false
    },
    {
      "pattern": ".*",
      "allowEdits": true
    }
  ]
}
