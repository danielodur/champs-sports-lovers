{
  "expo": {
    "name": "Champs",
    "slug": "champs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "extra": {
      "rapidApiKey": "EXPO_PUBLIC_RAPID_API_KEY_PRO",
      "apiFootballHost": "api-football-v1.p.rapidapi.com",
      "newsDataApiKey": "EXPO_PUBLIC_NEWSDATA.IO_API_KEY",
      "guardianApiKey": "EXPO_PUBLIC_GUARDIAN_API_KEY",
      "gNewsApiKey": "EXPO_PUBLIC_GNEWS_API_KEY",
      "mediaStackApiKey": "EXPO_PUBLIC_MEDIASTACK_API_KEY",
      "footballDataApiKey": "EXPO_PUBLIC_FOOTBALL_DATA.ORG_API",
      "sportRadarApiKey": "EXPO_PUBLIC_SPORTRADAR_API_KEY",
      "environment": "development",
      "enableRealData": true,
      "useMockData": false,
      "apiRateLimit": "conservative",
      "cacheEnabled": true,
      "mockFallbackEnabled": false,
      "supabaseUrl": "EXPO_PUBLIC_SUPABASE_URL",
      "supabaseAnonKey": "EXPO_PUBLIC_SUPABASE_ANON_KEY",
      "supabaseRedirectUrl": "EXPO_PUBLIC_SUPABASE_REDIRECT_URL",
      "passwordResetWebsite": "EXPO_PUBLIC_PASSWORD_RESET_WEBSITE",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ded7dd08-220c-4a13-a8e2-5ba8ba0a1fd3"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.champs.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to take profile pictures for your account.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select images for your profile picture.",
        "NSMicrophoneUsageDescription": "This app may need microphone access for video features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.champs.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "sdkVersion": "53.0.0",
    "platforms": ["ios", "android", "web"],
    "scheme": "champs",
    "privacy": "public",
    "githubUrl": "https://github.com/yourusername/champs",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Champs to access your photo library to select profile pictures.",
          "cameraPermission": "Allow Champs to use your camera to take profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "androidMode": "default",
          "androidCollapsedTitle": "New Notification",
          "iosDisplayInForeground": true,
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.65605327855-bbjb8tsm97ee40lquj4053218i1kurt2"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#ffffff"
    }
  }
}
